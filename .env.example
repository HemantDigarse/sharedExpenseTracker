# ==============================================================
# Environment Variables — Example Configuration
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).
# ==============================================================

# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/expense_tracker
DATABASE_USERNAME=expense_user
DATABASE_PASSWORD=expense_pass

# ---- Application ----
SERVER_PORT=8080

# ---- JWT ----
# MUST be at least 32 characters (256 bits) for HS256 security.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRATION=86400000

# ---- Currency ----
# Static USD to INR conversion rate.
# See DECISIONS.md for rationale on static vs. dynamic rates.
USD_TO_INR_RATE=83.00
